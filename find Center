#include <iostream>
#include <vector>
using namespace std;
int findCenter(vector<vector<int>>& edges) {
	int findCenter(vector<vector<int>>&edges) {
		if (edges[1][0] == edges[0][0] || edges[1][1] == edges[0][0]) {
			return edges[0][0];
		}

		return edges[0][1];
	}
	return edges[1][0];
}

int main() {

	vector<vector<int>> edges = {
		{1, 2},
		{2, 3}, 
		{4, 2} 
	};

	cout << findCenter(edges) << endl;

}
